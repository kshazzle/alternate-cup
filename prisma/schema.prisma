generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Universe {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  scenario         String
  summary          String
  generatedContent Json
  divergenceScore  Int
  chaosScore       Int
  winner           String?
  parentUniverseId String?
  parentUniverse   Universe?  @relation("UniverseBranches", fields: [parentUniverseId], references: [id], onDelete: SetNull)
  branches         Universe[] @relation("UniverseBranches")
  promptVersion    String
  model            String
  createdBy        String?
  upvotes          Upvote[]
  upvoteCount      Int        @default(0)
  views            Int        @default(0)
  shares           Int        @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([views])
  @@index([shares])
  @@index([divergenceScore])
  @@index([chaosScore])
  @@index([parentUniverseId])
  @@index([chaosScore, divergenceScore, createdAt])
  @@index([parentUniverseId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([resetAt])
}

// Auth.js required models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  accounts      Account[]
  sessions      Session[]
  upvotes       Upvote[]
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model Upvote {
  id           String   @id @default(cuid())
  userId       String
  universeId   String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universe     Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, universeId])
  @@index([universeId])
}
